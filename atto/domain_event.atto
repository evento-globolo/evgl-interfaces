// Transport-neutral AttoLang binding for schemas/event.schema.json.
// This is NOT a JSON serializer or an HTTP transport. Date-time parsing remains
// the responsibility of the wire-schema validator at the boundary.
define class DomainEvent as
    mut string id = "";
    mut string event_type = "";
    mut string occurred_at = "";

    constructor(string id_value, string type_value, string occurred_at_value) {
        self.id = id_value;
        self.event_type = type_value;
        self.occurred_at = occurred_at_value;
    }

    pub get_id(): string { return self.id; }
    pub get_type(): string { return self.event_type; }
    pub get_occurred_at(): string { return self.occurred_at; }

    // Presence check only; does not validate RFC 3339 / JSON Schema date-time.
    pub has_required_fields(): bool {
        if self.id.trim() eq "" then return false; fi
        if self.event_type.trim() eq "" then return false; fi
        if self.occurred_at.trim() eq "" then return false; fi
        return true;
    }
end

pub fnc event_id_wire_key(): string { return "id"; }
pub fnc event_type_wire_key(): string { return "type"; }
pub fnc event_occurred_at_wire_key(): string { return "occurredAt"; }
